<div class="chat-container">
  <aside class="sidebar">
    <h2><%= link_to "Dashboard", root_path %></h2>
    <h3>Rooms</h3>
    
    <%= turbo_stream_from "rooms" %>
    <div id="rooms">
      <%= render @rooms %>
    </div>

    <%= turbo_stream_from "users" %>
    <%= render "users/users", users: User.where(online: true) %>
    
    <div class="new-room-form">
      <h3>New Room</h3>
      <%= form_with(model: @new_room, id: "new_room_form") do |form| %>
        <%= form.text_field :name, placeholder: "Room name..." %>
        <%= form.submit "Create" %>
      <% end %>
    </div>
  </aside>

  <main class="main-content">
    <div class="welcome-screen">
      <h1>Welcome to Rails Chat</h1>
      <p>Select a room from the sidebar to start chatting in real-time.</p>
    </div>
  </main>
</div>
