<div class="chat-container">
  <aside class="sidebar">
    <h2><%= link_to "Dashboard", root_path %></h2>
    <h3><%= link_to "Rooms", rooms_path %></h3>
    
    <%= turbo_stream_from "rooms" %>
    <div id="rooms">
      <%= render Room.all %>
    </div>

    <%= turbo_stream_from "users" %>
    <%= render "users/users", users: User.where(online: true) %>
  </aside>

  <main class="main-content">
    <header class="room-header">
      <h1>#<%= @room.name %></h1>
    </header>

    <%# This is the magic line that subscribes the page to Action Cable broadcasts for this specific room %>
    <%= turbo_stream_from @room %>

    <div id="messages" class="messages-list">
      <%= render @messages %>
    </div>

    <footer class="message-input">
      <%= render "messages/form", room: @room, message: @new_message %>
    </footer>
  </main>
</div>
