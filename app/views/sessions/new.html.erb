<div class="auth-container">
  <h1>Login</h1>
  <%= form_tag login_path do %>
    <div class="field">
      <%= label_tag :name %>
      <%= text_field_tag :name, nil, required: true %>
    </div>

    <div class="field">
      <%= label_tag :password %>
      <%= password_field_tag :password, nil, required: true %>
    </div>

    <%= submit_tag "Login", class: "btn-primary" %>
  <% end %>

  <p>Don't have an account? <%= link_to "Sign Up", signup_path %></p>
</div>
